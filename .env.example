# LangGraph LocalAI TV Pipeline — Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for LLM calls)
OPENAI_API_KEY=sk-your-openai-api-key-here

# News API Key (optional — for headline fetching)
NEWS_API_KEY=your-news-api-key-here

# Video Generation API (optional — uses mock by default)
VIDEO_API_KEY=your-video-api-key-here

# Human Approval Mode: "cli" or "webhook"
APPROVAL_MODE=cli

# Checkpoint Database Path
CHECKPOINT_DB=./checkpoints.db
